# ============================================================================
# YACELLTECH SALESBOARD — CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Copia este archivo a .env.local y completa tus credenciales de Supabase
# ============================================================================

# URL del proyecto de Supabase (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (anon key) de Supabase — segura para usar en el navegador con RLS activo
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# Clave de servicio (service_role key) — OPCIONAL y SOLO SERVIDOR (nunca exponer con NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-solo-servidor

# URL pública del sitio (para producción / futuro dominio)
NEXT_PUBLIC_SITE_URL=https://salesboard.yacelltech.com

# Zona horaria oficial del tablero (por defecto America/Santo_Domingo)
NEXT_PUBLIC_TIMEZONE=America/Santo_Domingo

# Modo de demostración local cuando Supabase no está configurado (true | false)
# En producción con Supabase configurado, déjalo en false para no mezclar datos demo con producción.
NEXT_PUBLIC_ENABLE_DEMO_FALLBACK=false
